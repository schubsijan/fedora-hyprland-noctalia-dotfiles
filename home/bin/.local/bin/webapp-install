#!/usr/bin/env bash
# webapp-install – Webseite als eigene "App" anlegen (nach dem Vorbild von omarchy-webapp-install)
#
#   webapp-install                         interaktiv (Name, URL, Icon abfragen)
#   webapp-install <name> <url> [icon]     icon: leer = automatisch von der Seite,
#                                          http(s)-URL, lokale Bilddatei oder Icon-Name
#
# Legt ~/.local/share/applications/<name>.desktop an, das Helium mit --app=<url> startet
# (eigenes Fenster ohne Tabs/Adressleiste). Danach im Launcher (SUPER+SPACE) zu finden.
# Erkennungsmerkmal für webapp-remove: Zeile "X-Dotfiles-Webapp=true".
# Im Menü: SUPER+ALT+SPACE → "Webapp installieren" (pkg-menu-Plugin).

set -euo pipefail

BROWSER=helium
ICON_DIR="$HOME/.local/share/icons/hicolor/256x256/apps"
DESKTOP_DIR="$HOME/.local/share/applications"

die() { echo -e "\e[31m$*\e[0m" >&2; [ -n "${PKG_WAIT:-}" ] && read -rp $'\nEnter zum Schließen … ' _; exit 1; }
notify() { noctalia msg notification-show "$1" >/dev/null 2>&1 || true; echo "$1"; }

# "Mein Mail!" -> "mein-mail" (Dateiname fürs Icon)
safe_name() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//'; }

# Schema ergänzen; nur http(s), sonst würde Chromium z.B. javascript:/file: als Dokument öffnen
normalize_url() {
	local url=$1
	[[ $url =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]] || url="https://$url"
	[[ $url =~ [[:space:]] ]] && die "Die URL darf keine Leerzeichen enthalten."
	[[ ${url,,} =~ ^https?:// ]] || die "Nur http(s)-URLs sind erlaubt."
	printf '%s' "$url"
}

download_icon() {
	curl -fsSL --max-time 10 -o "$2" "$1" 2>/dev/null &&
		[[ -s $2 && $(file -b --mime-type "$2") == image/* ]]
}

# Reihenfolge: apple-touch-icon aus dem HTML (meist ≥180px), Standardpfad, Google-Favicon-Dienst
fetch_site_icon() {
	local site=$1 dest=$2 origin page icon
	origin=$(sed -E 's|^(https?://[^/]+).*|\1|' <<<"$site")
	page=$(curl -fsSL --max-time 5 "$site" 2>/dev/null | head -c 100000 | tr '\n' ' ' || true)
	icon=$(grep -oiE "<link[^>]*rel=[\"'][^\"']*apple-touch-icon[^\"']*[\"'][^>]*>" <<<"$page" |
		grep -oiE "href=[\"'][^\"']+" | head -1 | sed -E "s/^href=[\"']//" || true)
	case $icon in
	http://* | https://*) ;;
	//*) icon="https:$icon" ;;
	/*) icon="$origin$icon" ;;
	?*) icon="$origin/$icon" ;;
	esac
	{ [[ -n $icon ]] && download_icon "$icon" "$dest"; } ||
		download_icon "$origin/apple-touch-icon.png" "$dest" ||
		download_icon "https://www.google.com/s2/favicons?domain=${origin#*://}&sz=256" "$dest"
}

# Wert für eine .desktop-Zeile: Zeilenumbrüche würden sonst eine zweite Exec= einschleusen
desktop_string() {
	local v=$1
	v=${v//\\/\\\\}; v=${v//$'\t'/\\t}; v=${v//$'\r'/\\r}; v=${v//$'\n'/\\n}
	printf '%s' "$v"
}

# Ein Exec-Argument in "…" nach freedesktop-Spec (" ` $ \ maskieren, % verdoppeln)
desktop_exec_arg() {
	printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/`/\\`/g' -e 's/\$/\\$/g' -e 's/%/%%/g')"
}

# Fensterklasse, die Chromium einem --app-Fenster gibt (Host + Pfad), damit Launcher/Dock
# das Fenster der .desktop-Datei zuordnen (Icon, Name)
window_class() {
	local address=${1#*://} host path
	address=${address%%[?#]*}
	host=${address%%/*}
	path=${address:${#host}}
	host=${host##*@}; host=${host%%:*}
	printf 'chrome-%s_%s-Default' "${host,,}" "${path:-/}" | sed 's|/|_|g'
}

if (($# >= 2)); then
	NAME=$1 URL=$2 ICON_REF=${3:-}
else
	echo -e "\e[1;32mWebapp anlegen\e[0m – öffnet die Seite in einem eigenen Helium-Fenster\n"
	read -rep "Name: " NAME
	read -rep "URL:  " URL
	echo -e "\e[90mIcon: Enter = automatisch von der Seite · oder Bild-URL, Datei oder Icon-Name"
	echo -e "      (gute Icons: https://dashboardicons.com)\e[0m"
	read -rep "Icon: " ICON_REF
fi

NAME=$(sed 's/^[[:space:]]*//; s/[[:space:]]*$//' <<<"$NAME")
[ -n "$NAME" ] || die "Kein Name angegeben."
[[ $NAME == */* ]] && die "Der Name darf kein '/' enthalten (URL ins falsche Feld getippt?)."
[ -n "$URL" ] || die "Keine URL angegeben."
URL=$(normalize_url "$URL")

DESKTOP_FILE="$DESKTOP_DIR/$NAME.desktop"
if [ -f "$DESKTOP_FILE" ] && ! grep -q '^X-Dotfiles-Webapp=true' "$DESKTOP_FILE"; then
	die "$DESKTOP_FILE gibt es schon und ist keine Webapp – anderen Namen wählen."
fi

# Icon besorgen
ICON_FILE="$ICON_DIR/$(safe_name "$NAME").png"
mkdir -p "$ICON_DIR" "$DESKTOP_DIR"
if [[ -z $ICON_REF ]]; then
	echo "Lade Icon von $URL …"
	fetch_site_icon "$URL" "$ICON_FILE" || die "Kein Icon gefunden – bitte eine Bild-URL angeben."
	ICON=$(safe_name "$NAME")
elif [[ $ICON_REF =~ ^https?:// ]]; then
	download_icon "$ICON_REF" "$ICON_FILE" || die "Icon konnte nicht geladen werden: $ICON_REF"
	ICON=$(safe_name "$NAME")
elif [[ -f ${ICON_REF/#\~/$HOME} ]]; then
	ICON_REF=${ICON_REF/#\~/$HOME}
	ext=${ICON_REF##*.}
	[[ $ext == "$ICON_REF" ]] && ext=png
	ICON_FILE="$ICON_DIR/$(safe_name "$NAME").$ext"
	cp "$ICON_REF" "$ICON_FILE"
	ICON=$(safe_name "$NAME")
else
	ICON=$ICON_REF # Name eines installierten Icons (Icon-Theme)
fi
gtk-update-icon-cache -q "$HOME/.local/share/icons/hicolor" &>/dev/null || true

cat >"$DESKTOP_FILE" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=$(desktop_string "$NAME")
Comment=Webapp: $(desktop_string "$URL")
Exec=$(desktop_string "$BROWSER --app=$(desktop_exec_arg "$URL")")
Icon=$(desktop_string "$ICON")
Terminal=false
StartupNotify=true
StartupWMClass=$(desktop_string "$(window_class "$URL")")
Categories=Network;WebBrowser;
X-Dotfiles-Webapp=true
EOF
chmod +x "$DESKTOP_FILE"
update-desktop-database "$DESKTOP_DIR" &>/dev/null || true

notify "Webapp '$NAME' angelegt – im Launcher (SUPER+SPACE) zu finden"

[ -n "${PKG_WAIT:-}" ] && read -rp $'\nEnter zum Schließen … ' _
exit 0

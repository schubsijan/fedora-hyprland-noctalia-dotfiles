[Plymouth Theme]
Name=Noctalia
Description=Fedora-Logo und Passwortabfrage in den Noctalia-Farben (nach dem Omarchy-Theme).
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/noctalia
ScriptFile=/usr/share/plymouth/themes/noctalia/noctalia.script
ConsoleLogBackgroundColor=0x232a2e
MonospaceFont=Cantarell 11
Font=Cantarell 11
